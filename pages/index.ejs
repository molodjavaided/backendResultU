<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <% if (created) {%>
        <div class="alert alert-success">
            Note has been created
        </div>
        <%} %>

            <div class="container">
                <h1>
                    <%= title %>
                </h1>

                <form action="/" method="post" class="mb-2">
                    <div class="form-group mb-2">
                        <input type="text" class="form-control" name="title" required>
                    </div>

                    <button class="btn btn-primary" type="submit">Create!</button>
                </form>

                <% if (notes.length) {%>
                    <div class="card">
                        <ul class="list-group">
                            <% for (let i=0; i < notes.length; i++) { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="list-title">
                                        <%= notes[i].title %>
                                    </div>

                                    <div class="edit-title" style="display: none;">
                                        <input type="text" class="edit-input" value="<%= notes[i].title %>">
                                    </div>

                                    <div class="buttons">
                                        <div class="edit-buttons">
                                            <button class="btn btn-danger" data-type="update"
                                                data-id="<%= notes[i].id %>">Обновить</button>
                                            <button class="btn btn-danger" data-type="remove"
                                                data-id="<%= notes[i].id %>">&times;</button>
                                        </div>
                                        <div class="save-buttons" style="display: none;">
                                            <button class="btn btn-danger" data-type="save"
                                                data-id="<%= notes[i].id %>">Сохранить</button>
                                            <button class="btn btn-danger" data-type="cancel"
                                                data-id="<%= notes[i].id %>">Отменить</button>
                                        </div>
                                    </div>
                                </li>
                                <% } %>
                        </ul>
                    </div>
                    <%} else { %>
                        <p>No notes!</p>
                        <% } %>
            </div>

            <script src="app.js"></script>
</body>

</html>